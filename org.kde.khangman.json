            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/khangman-26.08.3.tar.xz",
                    "sha256": "2523e94fbed2f23112e608103b8d565f3c185a45b25b692abcc9743320b5cbcf",
                    "x-checker-data": {
                        "type": "anitya",
