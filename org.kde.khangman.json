            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.04.2/src/khangman-26.04.2.tar.xz",
                    "sha256": "92df44a17f4cb0cd62af9ecc16f61669b83f1c259f70992d31fc3c76739d078c",
                    "x-checker-data": {
                        "type": "anitya",
