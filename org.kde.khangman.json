                "-DBUILD_TESTING=OFF",
                "-DQT_MAJOR_VERSION=6"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/libkeduvocdocument-26.08.0.tar.xz",
                    "sha256": "a2a62ee5be1d6aae3180dcbebf311475a8e7b8eb46ac058f4df1a27828d58a09",
                    "x-checker-data": {
                        "type": "anitya",
