                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/libkeduvocdocument-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kdeedu-data",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/kdeedu-data-26.08.0.tar.xz",
                    "sha256": "29a6db7dc01fd8a6402febaf74e54136b8754ddf3938e01db139a8011c1f2c2e",
