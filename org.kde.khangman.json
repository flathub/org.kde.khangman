            "name": "libkeduvocdocument",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DQT_MAJOR_VERSION=6"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/libkeduvocdocument-26.08.3.tar.xz",
                    "sha256": "c31d072cec35ad2c32f35d6ce305639aa6616e06d2662631c2c0b9120d1b63d9",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/libkeduvocdocument-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kdeedu-data",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/kdeedu-data-26.08.3.tar.xz",
                    "sha256": "c93742be1812f0afd9c26d034d910ebf26e6382dca54cf55dacbb19fe7385075",
